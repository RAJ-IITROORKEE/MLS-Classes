// Prisma schema for MLS Classes platform

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Book Trial Request
// ─────────────────────────────────────────────
model BookTrialRequest {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String
  phone          String
  studentName    String
  program        String
  grade          String
  timezone       String
  availability   String
  message        String?
  status         TrialStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum TrialStatus {
  PENDING
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// FAQ
// ─────────────────────────────────────────────
model FAQ {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Testimonial
// ─────────────────────────────────────────────
model Testimonial {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  role          String
  rating        Int      @default(5)
  text          String
  program       String?
  country       String?
  imageUrl      String?
  imagePublicId String?
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────
// Student Achievement
// ─────────────────────────────────────────────
model StudentAchievement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  description   String
  imageUrl      String
  imagePublicId String
  isActive      Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
